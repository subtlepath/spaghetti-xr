+namespace Fast {
+
+void GfxWindowBackendVisionOS::Init(const char* gameName, const char* apiName, bool startFullScreen, uint32_t width,
+                                    uint32_t height, int32_t posX, int32_t posY) {
+    // Every one of these describes a window, and there is no window. The
+    // surface's size comes from the shell and nothing else can change it.
+    (void)gameName;
+    (void)apiName;
+    (void)startFullScreen;
+    (void)width;
+    (void)height;
+    (void)posX;
+    (void)posY;
+
+    // Not SDL_INIT_VIDEO: that subsystem is not built. Events are, and the
+    // joystick subsystem the control deck initialises delivers through them.
+    SDL_InitSubSystem(SDL_INIT_EVENTS);
+
+    mNextFrame = std::chrono::steady_clock::now();
+
+    // The ImGui platform half of this is a no-op on visionOS (see Gui.cpp), but
+    // Gui::Init also creates the ImGui context and calls into the Metal backend,
+    // so it still has to happen here, at the same point in startup that the SDL2
+    // backend calls it.
+    Ship::GuiWindowInitData windowImpl;
+    windowImpl.Metal = { nullptr, nullptr };
+    Ship::Context::GetInstance()->GetWindow()->GetGui()->Init(windowImpl);
+}
+
+void GfxWindowBackendVisionOS::Close() {
+    mIsRunning = false;
+}
+
+void GfxWindowBackendVisionOS::SetKeyboardCallbacks(bool (*onKeyDown)(int scancode), bool (*onKeyUp)(int scancode),
+                                                    void (*onAllKeysUp)()) {
+    mOnKeyDown = onKeyDown;
+    mOnKeyUp = onKeyUp;
+    mOnAllKeysUp = onAllKeysUp;
+}
+
+void GfxWindowBackendVisionOS::SetMouseCallbacks(bool (*onMouseButtonDown)(int btn),
+                                                 bool (*onMouseButtonUp)(int btn)) {
+    mOnMouseButtonDown = onMouseButtonDown;
+    mOnMouseButtonUp = onMouseButtonUp;
+}
+
+void GfxWindowBackendVisionOS::SetFullscreenChangedCallback(void (*onFullscreenChanged)(bool isNowFullscreen)) {
+    mOnFullscreenChanged = onFullscreenChanged;
+}
+
+// A fully immersive space is the only mode this app has, so the engine is always
+// "fullscreen" and can never be asked to stop being it.
+void GfxWindowBackendVisionOS::SetFullscreen(bool fullscreen) {
+    (void)fullscreen;
+}
+
+bool GfxWindowBackendVisionOS::IsFullscreen() {
+    return true;
+}
+
+void GfxWindowBackendVisionOS::GetActiveWindowRefreshRate(uint32_t* refreshRate) {
+    // The compositor's rate, not this backend's own pacing. Upstream derives its
+    // interpolation target from this and then calls SetTargetFps with the
+    // result, so answering with mTargetFps would be answering with the previous
+    // answer — stable today only because the two happen to agree, and stuck at
+    // the lower of them the moment a user raises the interpolation setting.
+    *refreshRate = SpaghettiPad_RenderDisplayRate();
+}
+
+// No pointer exists in an immersive space; head and hand input arrive through
+// ARKit and GameController instead. These are stubs because there is nothing
+// truthful to return, not because the work was skipped.
+void GfxWindowBackendVisionOS::SetCursorVisibility(bool visible) {
+    (void)visible;
