+    // AdjXForAspectRatio's factor, cancelled in advance. Read from the same
+    // dimensions it reads, so the two cannot drift apart.
+    float xScale = 1.0f;
+    if (mCurDimensions.height > 0 && mCurDimensions.width > 0) {
+        xScale = ((float)mCurDimensions.width / (float)mCurDimensions.height) / (4.0f / 3.0f);
+    }
+
+    float frustum[4][4];
+    BuildEyeFrustum(mStereoTangents, nearPlane, farPlane, xScale, frustum);
+    float eyeProjection[4][4];
+    MatrixMul(eyeProjection, mStereoEyeFromRecentre, frustum);
+    if (mStereoGameHasPre) {
+        // The game's camera, exactly as the game multiplied it onto its
+        // projection stack, applied ahead of the eye. This is the whole of the
+        // head-tracking contract: the camera's frame is where the game says it
+        // is — forward follows the race — and the wearer's pose, inside
+        // mStereoEyeFromRecentre, looks around from there.
+        MatrixMul(replacement, mStereoGamePre, eyeProjection);
+    } else {
+        memcpy(replacement, eyeProjection, sizeof(float) * 16);
+    }
+
+    // Temporary. Mode B renders at rate on hardware and shows black, with the
+    // engine known good — the same frames drawn flat are correct and audible. The
+    // substitution above is therefore the only suspect, and nothing about it is
+    // logged, so this prints its inputs, its output, and what it does to points
+    // that must be on screen. Four calls covers both eyes twice.
+    if (mStereoDiagnostics < 4) {
+        ++mStereoDiagnostics;
+
+        // Where the game's own projection puts a point is the control: it is what
+        // the flat screen draws, and the flat screen is correct.
+        const float probes[3][3] = {
+            { 0.0f, 0.0f, -100.0f },   // straight ahead, near
+            { 0.0f, 0.0f, -1000.0f },  // straight ahead, mid
+            { 200.0f, 100.0f, -500.0f } // off-axis
+        };
+
+        SPDLOG_WARN("[modeB] eye pass {}: near {:.3f} far {:.1f} (recovered), scale "
+                    "{:.4f} m/unit, xScale {:.4f}, dims {}x{}",
+                    mStereoDiagnostics, nearPlane, farPlane, metresPerUnit, xScale,
+                    mCurDimensions.width, mCurDimensions.height);
+        SPDLOG_WARN("[modeB] tangents L{:.3f} R{:.3f} U{:.3f} D{:.3f}", mStereoTangents[0],
+                    mStereoTangents[1], mStereoTangents[2], mStereoTangents[3]);
+        for (int row = 0; row < 4; ++row) {
+            SPDLOG_WARN("[modeB] eyeFromRecentre[{}] {:+.5f} {:+.5f} {:+.5f} {:+.5f}", row,
+                        mStereoEyeFromRecentre[row][0], mStereoEyeFromRecentre[row][1],
+                        mStereoEyeFromRecentre[row][2], mStereoEyeFromRecentre[row][3]);
+        }
+        for (int row = 0; row < 4; ++row) {
+            SPDLOG_WARN("[modeB] game[{}] {:+.5f} {:+.5f} {:+.5f} {:+.5f}   ->   "
+                        "replacement[{}] {:+.5f} {:+.5f} {:+.5f} {:+.5f}",
+                        row, game[row][0], game[row][1], game[row][2], game[row][3], row,
+                        replacement[row][0], replacement[row][1], replacement[row][2],
+                        replacement[row][3]);
+        }
+        for (const auto& probe : probes) {
+            float out[2][4];
+            const float* matrices[2] = { &game[0][0], &replacement[0][0] };
+            for (int which = 0; which < 2; ++which) {
+                for (int col = 0; col < 4; ++col) {
+                    out[which][col] = probe[0] * matrices[which][0 * 4 + col] +
+                                      probe[1] * matrices[which][1 * 4 + col] +
+                                      probe[2] * matrices[which][2 * 4 + col] +
+                                      1.0f * matrices[which][3 * 4 + col];
+                }
+            }
+            // NDC is what decides whether a vertex survives. A w at or below zero
+            // is behind the eye and rejected outright; anything outside [-1, 1] on
+            // x or y is off the side of the view, and Fast3D's z is [-w, w] here
+            // because the remap to [0, w] happens later, in GfxSpTri1.
+            SPDLOG_WARN("[modeB] probe ({:.0f},{:.0f},{:.0f}) game ndc "
+                        "({:+.3f},{:+.3f},{:+.3f}) w {:+.2f}  |  replacement ndc "
+                        "({:+.3f},{:+.3f},{:+.3f}) w {:+.2f}",
+                        probe[0], probe[1], probe[2], out[0][0] / out[0][3],
+                        out[0][1] / out[0][3], out[0][2] / out[0][3], out[0][3],
+                        out[1][0] / out[1][3], out[1][1] / out[1][3], out[1][2] / out[1][3],
+                        out[1][3]);
+        }
+    }
+}
