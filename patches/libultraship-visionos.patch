+
+void GfxWindowBackendVisionOS::HandleEvents() {
+    // The joystick and game controller subsystems refresh from inside the event
+    // pump, so this still has to run every frame even with no window events —
+    // and the queue has to be drained by someone or it grows without bound.
+    //
+    // Everything except SDL_CONTROLLERDEVICEADDED and SDL_CONTROLLERDEVICEREMOVED,
+    // which are not this backend's to consume. Ship::SDLAddRemoveDeviceEventHandler
+    // takes them out of the queue from inside the GUI update, and it is the only
+    // caller of ConnectedPhysicalDeviceManager::RefreshConnectedSDLGamepads — the
+    // one function that opens an SDL gamepad and makes it visible to a port. A
+    // controller whose arrival event is eaten before that handler runs is never
+    // opened, so it never reaches the game, however well it is mapped.
+    //
+    // The SDL2 backend skips exactly these two, by peeping the ranges either side
+    // of them, and this is the same two ranges. They are adjacent in SDL_EventType
+    // — SDL_CONTROLLERDEVICEREMAPPED, which follows and which nothing here needs,
+    // falls in the upper range and is drained with the rest.
+    SDL_PumpEvents();
+    SDL_Event event;
+    while (SDL_PeepEvents(&event, 1, SDL_GETEVENT, SDL_FIRSTEVENT, SDL_CONTROLLERDEVICEADDED - 1) > 0) {
+    }
+    while (SDL_PeepEvents(&event, 1, SDL_GETEVENT, SDL_CONTROLLERDEVICEREMOVED + 1, SDL_LASTEVENT) > 0) {
+    }
+
+    ReportInputDevices();
+}
+
+// What the control deck holds, not what SDL enumerated: an unmapped pad is
+// enumerated but never opened, and the difference is the whole of why a
+// controller can appear to do nothing. Polled rather than driven by the events
+// above, because those belong to the handler that acts on them and reading the
+// result is the only way to see what it did.
+void GfxWindowBackendVisionOS::ReportInputDevices() {
+    auto context = Ship::Context::GetInstance();
+    if (context == nullptr || context->GetControlDeck() == nullptr) {
+        return;
+    }
+
+    auto manager = context->GetControlDeck()->GetConnectedPhysicalDeviceManager();
+    if (manager == nullptr) {
+        return;
+    }
+
+    // Ordered, so the same set of controllers always produces the same string and
+    // a reconnect that changes only SDL's instance ids is not reported as a change.
+    std::map<int32_t, std::string> byInstanceId;
+    for (const auto& [instanceId, name] : manager->GetConnectedSDLGamepadNames()) {
+        byInstanceId[instanceId] = name;
+    }
+
+    std::string names;
+    for (const auto& [instanceId, name] : byInstanceId) {
+        if (!names.empty()) {
+            names += ", ";
+        }
+        names += name;
+    }
+
+    if (mHasReportedInputDevices && names == mReportedInputDevices) {
+        return;
+    }
+
+    mHasReportedInputDevices = true;
+    mReportedInputDevices = names;
+    SpaghettiPad_InputDevicesChanged(static_cast<int>(byInstanceId.size()), names.c_str());
+}
+
+bool GfxWindowBackendVisionOS::IsFrameReady() {
+    // False while the immersive space is closed. The game loop then idles
+    // instead of rendering frames that nothing would ever show.
+    return SpaghettiPad_RenderIsLive() != 0;
+}
+
+// The compositor does not pace the engine: it presents whatever the latest
+// finished frame is, at the headset's rate, which is not the engine's. So the
+// engine paces itself, exactly as the SDL2 backend does when vsync is off.
+void GfxWindowBackendVisionOS::SyncFramerateWithTime() {
+    using namespace std::chrono;
+
+    const int fps = mTargetFps > 0 ? static_cast<int>(mTargetFps) : 60;
+    const auto interval = duration_cast<steady_clock::duration>(duration<double>(1.0 / fps));
+    const auto now = steady_clock::now();
+
+    // A long stall — the space closed, a mod loaded, the app was suspended —
+    // must not turn into a burst of catch-up frames.
+    if (mNextFrame < now - interval * 4 || mNextFrame > now + interval * 4) {
+        mNextFrame = now;
+    }
+
+    mNextFrame += interval;
+    const auto remaining = mNextFrame - now;
+    if (remaining > steady_clock::duration::zero()) {
+        const auto ns = duration_cast<nanoseconds>(remaining).count();
+        const timespec spec = { static_cast<time_t>(ns / 1000000000), static_cast<long>(ns % 1000000000) };
+        nanosleep(&spec, nullptr);
+    }
+}
+
+void GfxWindowBackendVisionOS::SwapBuffersBegin() {
+    SyncFramerateWithTime();
+}
