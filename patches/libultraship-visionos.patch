+void Interpreter::EndStereoEye() {
+    if (!mStereoActive) {
+        return;
+    }
+
+    // Temporary, and reported here because this is the one point that knows an
+    // eye has finished. "drawn" is what reached the rendering API.
+    if (mEyeDiagnostics < 6) {
+        ++mEyeDiagnostics;
+        SPDLOG_WARN("[tris] eye {}: {} triangles, {} clipped away, {} culled, {} drawn",
+                    mEyeDiagnostics, mTriangleTotal, mTriangleClipRejected, mTriangleCullRejected,
+                    mTriangleTotal - mTriangleClipRejected - mTriangleCullRejected);
+    }
+    mTriangleTotal = 0;
+    mTriangleClipRejected = 0;
+    mTriangleCullRejected = 0;
+    // What the next pass over this display list should expect. Both eyes run
+    // the same list, so "did the previous pass ever load a perspective
+    // projection" predicts the next one exactly; across a scene change it is
+    // wrong for a single eye and then right again.
+    mStereoLastEyeHadPerspective = mStereoEyeSawPerspective;
+    // Leave the game's own projection where the game expects to find it. Whoever
+    // draws next — the second eye, a Mode A frame, the GUI-only path — is
+    // entitled to assume P_matrix means what the display list last said it
+    // means, and only this function knows that it currently does not.
+    memcpy(mRsp->P_matrix, mStereoGameProjection, sizeof(mStereoGameProjection));
+    if (mRsp->modelview_matrix_stack_size > 0) {
+        MatrixMul(mRsp->MP_matrix, mRsp->modelview_matrix_stack[mRsp->modelview_matrix_stack_size - 1],
+                  mRsp->P_matrix);
+    }
+    mStereoActive = false;
+}
+
+// Builds what replaces one projection matrix. Called for every projection the
+// game loads or multiplies while an eye is open, because the answer depends on
+// what the game asked for and not only on which eye is being drawn.
+//
+// The classification reads mStereoGameLoaded — the matrix the last LOAD
+// carried — never the composed product in `game`. Mario Kart 64 multiplies its
+// camera's lookAt onto the projection stack, and camera-times-perspective does
+// not classify as perspective: its w row carries the camera translation. An
+// earlier build classified the product, and every draw after the camera MUL —
+// the entire racing world — silently took the orthographic path below, flat on
+// the HUD panel, while the LOAD a moment earlier had classified and logged
+// correctly. That is what a wearer measured as "everything is too close" and
+// "turning my head does nothing": they were looking at a projected photograph
+// of the world, not the world.
+void Interpreter::StereoProjection(const float game[4][4], float replacement[4][4]) {
+    if (!IsPerspectiveProjection(mStereoGameLoaded)) {
+        // The 2D passes keep their own matrix and land on a panel: scaled to
+        // its extent and centred where this eye's projection of the panel
+        // fell, all in clip space as multiples of the pass's own w.
+        // Convergence is inside the centre — BeginStereoEye projected a real
+        // point through this eye's real pose — so nothing is added on top.
+        //
+        // Which panel depends on what the pass is. An orthographic pass before
+        // the frame's first perspective load, in a frame whose previous pass
+        // had one, is scenery — the skybox, drawn behind a world that now has
+        // real depths, which a card two metres out would float in front of.
+        // Everything else — the HUD, and every 2D pass of a frame with no
+        // perspective in it at all — is overlay, and belongs at reading
+        // distance.
+        const bool backdrop = !mStereoEyeSawPerspective && mStereoLastEyeHadPerspective;
+        const float* centre = backdrop ? mStereoBgCentre : mStereoHudCentre;
+        const float* scale = backdrop ? mStereoBgScale : mStereoHudScale;
+
+        // The x terms are divided by the aspect factor GfxSpVertex will
+        // multiply back in — the panel's shape comes from the eye's tangents,
+        // and letterboxing meant for a desktop window has no business
+        // stretching it (at the eye's near-square aspect it *widened*
+        // everything by a third).
+        memcpy(replacement, game, sizeof(float) * 16);
+        float xCancel = 1.0f;
+        if (mCurDimensions.height > 0 && mCurDimensions.width > 0) {
+            xCancel =
+                ((float)mCurDimensions.width / (float)mCurDimensions.height) / (4.0f / 3.0f);
+        }
+        for (int i = 0; i < 4; ++i) {
+            replacement[i][0] = (scale[0] * game[i][0] + centre[0] * game[i][3]) * xCancel;
+            replacement[i][1] = scale[1] * game[i][1] + centre[1] * game[i][3];
+        }
+        return;
+    }
+
+    mStereoEyeSawPerspective = true;
+
+    float nearPlane = 0.0f;
+    float farPlane = 0.0f;
+    if (!RecoverNearFar(mStereoGameLoaded, &nearPlane, &farPlane)) {
+        memcpy(replacement, game, sizeof(float) * 16);
+        return;
+    }
+
+    const float metresPerUnit = SpaghettiPad_RenderWorldScale();
+    // Temporary: the clamp is disabled for this run. Pulling the near plane from
+    // the game's 100 units to 2.18 compresses everything visible into NDC z
+    // [0.95, 1.0], and while that should not blank a frame it is the one input to
+    // this matrix that is wildly different from what the game asked for. Keeping
+    // the game's own near costs the ability to lean into the world and settles
+    // whether the depth range is implicated at all.
+    constexpr bool kClampNearPlane = false;
+    if (kClampNearPlane && metresPerUnit > kMatrixEpsilon) {
+        const float nearestAllowed = kNearestNearPlaneMetres / metresPerUnit;
+        if (nearPlane > nearestAllowed && farPlane > nearestAllowed) {
+            nearPlane = nearestAllowed;
+        }
+    }
