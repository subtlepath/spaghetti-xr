+void Interpreter::EvictTextureCacheLru() {
+    TextureCacheMap::iterator it = mTextureCache.lru.front().it;
+    mTextureCache.free_texture_ids.push_back(it->second.texture_id);
+    for (int j = 0; j < SHADER_MAX_TEXTURES; j++) {
+        if (mRenderingState.mTextures[j] == &*it) {
+            mRenderingState.mTextures[j] = nullptr;
+        }
+    }
+    mTextureCache.total_bytes -= it->second.bytes;
+    if (!it->second.resource_path.empty()) {
+        // The GPU copy this entry owned is gone; the decoded CPU copy in the
+        // resource cache would otherwise outlive it forever, because nothing
+        // in this port ever unloads a resource. Dropping the cache's owning
+        // reference frees the pixels once nothing else holds them — the RDP's
+        // loaded_texture slots keep a shared_ptr for anything still in flight
+        // — and a texture drawn again later simply reloads from the archive.
+        Ship::Context::GetInstance()->GetResourceManager()->UnloadResource(it->second.resource_path);
+    }
+    if (mTextureCache.last_inserted == &*it) {
+        mTextureCache.last_inserted = nullptr;
+    }
+    mTextureCache.map.erase(it);
+    mTextureCache.lru.pop_front();
+}
+
+void Interpreter::RecordTextureUpload(const RawTexMetadata* metadata, uint32_t origSizeBytes) {
+    TextureCacheNode* node = mTextureCache.last_inserted;
+    mTextureCache.last_inserted = nullptr;
+    if (node == nullptr) {
+        return;
+    }
+
+    // An accounting estimate, not a measurement: an archive resource's pixels
+    // are its stated dimensions at four bytes each — that is what the import
+    // paths upload — and a raw N64 texture is bounded by its TMEM load
+    // expanded to RGBA32, where even 4-bit data grows eightfold. Overcounting
+    // a kilobyte texture is harmless; what matters is that a 64 MiB one
+    // counts as 64 MiB.
+    size_t bytes;
+    mTextureCache.total_bytes -= node->second.bytes;
+    node->second.resource_path.clear();
+    if (metadata != nullptr && metadata->resource != nullptr) {
+        bytes = (size_t)metadata->width * metadata->height * 4;
+        node->second.resource_path = metadata->resource->GetInitData()->Path;
+    } else {
+        bytes = (size_t)origSizeBytes * 8;
+    }
+    node->second.bytes = bytes;
+    mTextureCache.total_bytes += bytes;
+
+    while (mTextureCache.total_bytes > kTextureCacheBudgetBytes && !mTextureCache.lru.empty()) {
+        if (&*mTextureCache.lru.front().it == node) {
+            // A single texture larger than the whole budget; keep it — it is
+            // being drawn right now — and evict nothing else this round.
+            break;
+        }
+        EvictTextureCacheLru();
+    }
+}
