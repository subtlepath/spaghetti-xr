+#ifdef __VISIONOS__
+
+// --------------------------------------------------------------------- Mode B
+//
+// Everything here answers one question: what should replace the projection
+// matrix the game just loaded, so that the world it draws is the world the
+// wearer is sitting in rather than a picture hanging in front of them.
+//
+// The substitution happens at the projection and nowhere else, which is what
+// makes it tractable. A vertex reaches the projection already in the game's own
+// camera space — the modelview stack has taken it there — and Mario Kart 64's
+// camera space is, axis for axis, what Compositor Services calls right-up-back:
+// x right, y up, forward down -z. So the game's camera and the wearer's head can
+// simply be declared the same thing, and the only work left is to say where each
+// eye is relative to that head and what shape its frustum is.
+//
+// What is deliberately *not* done here: nothing touches the modelview stack, the
+// vertex transform, lighting, or clipping. The game keeps drawing the game.
+
+namespace {
+
+// Beyond this the near or far plane recovered from a projection is not believed
+// and the game's own matrix is used unchanged. A degenerate projection is a real
+// thing in N64 display lists — matrices get built from uninitialised memory
+// during transitions — and one frame of flat rendering is a far better failure
+// than one frame of geometry smeared across the wearer's field of view.
+constexpr float kMatrixEpsilon = 1e-6f;
+
+// The nearest the near plane is allowed to sit, in metres. Mario Kart 64 chooses
+// a near plane for a camera bolted behind a kart, which is not a camera anyone
+// can lean forward on. In Mode B they can, so the plane is pulled in far enough
+// that leaning does not open a hole in the world. Fast3D's Metal depth buffer is
+// 32-bit float, so what this costs in depth precision is close to nothing.
+constexpr float kNearestNearPlaneMetres = 0.12f;
+
+// Where the HUD hangs, in metres. Lap counter, positions and item box are drawn
+// in orthographic passes with no depth of their own; left alone they land at
+// infinity, which is the one distance guaranteed to fight every other thing in
+// view. Just beyond arm's length is far enough not to strain and near enough to
+// read.
+constexpr float kHudDistanceMetres = 2.2f;
+
+// How wide the HUD's panel is at that distance, in metres. Mode A hangs a
+// 1.6 m screen 2.0 m ahead and a wearer has read menus on it in comfort, so the
+// panel matches that arc rather than inventing a new number to test.
+constexpr float kHudPanelWidthMetres = 1.76f;
+
+// Where scene backdrops go — the skybox above all. Far enough that its
+// disparity is as close to nothing as the eyes can tell, which is where a sky
+// belongs, and comfortably beyond every distance the game's own world renders
+// at under any scale the slider offers.
+constexpr float kBackdropDistanceMetres = 60.0f;
+
+// Half the backdrop panel's angular width, as a tangent: 2.0 is ±63 degrees,
+// wider than the widest eye tangent a headset has reported (1.732), so the
+// panel covers the whole view with margin at the recentre-forward pose. The
+// game drew its sky for a narrower camera, so the picture is stretched; on
+// gradient skies that is invisible, and a stretched cloud is a far smaller
+// wrong than a sky card floating nearer than the track it is behind.
+constexpr float kBackdropHalfWidthTangent = 2.0f;
+
+// True for a projection that divides by depth. Orthographic matrices — the HUD,
+// the 2D overlays, the framebuffer blits — have a constant w, and replacing
+// theirs with a frustum would be replacing a deliberate flatness with a mistake.
+//
+// The vertical scale is tested alongside the depth divide, which is what RT64's
+// own classifier does in RSP::getCurrentProjectionType. A matrix can divide by
+// depth and still be degenerate — collapsed to a point, or assembled from
+// uninitialised memory during a transition, which is an ordinary event in an N64
+// display list — and no frustum can be recovered from one. Reading such a matrix
+// as flat costs a frame of the HUD's convergence; reading it as perspective costs
+// a frame of geometry smeared across the wearer's field of view. The two failures
+// are not equally priced, so the test leans towards flat.
+bool IsPerspectiveProjection(const float projection[4][4]) {
+    return fabsf(projection[2][3]) > kMatrixEpsilon && fabsf(projection[3][3]) < kMatrixEpsilon &&
+           fabsf(projection[1][1]) > kMatrixEpsilon;
+}
+
+// Recovers the near and far planes the game asked for, in game units.
+//
+// They are kept rather than replaced because they are the game's statement about
+// its own world: how far it intends to draw, and how it has budgeted its depth
+// buffer. The eye's frustum changes the *shape* of the view, which belongs to the
+// headset; it has no opinion about draw distance, which does not.
+//
+// F3D projections are OpenGL-convention, so with the w row normalised to -1 the
+// depth row reads a = -(f+n)/(f-n) and b = -2fn/(f-n), which inverts exactly.
+bool RecoverNearFar(const float projection[4][4], float* nearPlane, float* farPlane) {
+    const float w = -projection[2][3];
+    if (fabsf(w) < kMatrixEpsilon) {
+        return false;
+    }
+
+    const float a = projection[2][2] / w;
+    const float b = projection[3][2] / w;
+    if (fabsf(a - 1.0f) < kMatrixEpsilon || fabsf(a + 1.0f) < kMatrixEpsilon) {
+        return false;
+    }
+
+    const float recoveredNear = b / (a - 1.0f);
+    const float recoveredFar = b / (a + 1.0f);
+    if (!(recoveredNear > 0.0f) || !(recoveredFar > recoveredNear) || !std::isfinite(recoveredNear) ||
+        !std::isfinite(recoveredFar)) {
+        return false;
+    }
+
+    *nearPlane = recoveredNear;
+    *farPlane = recoveredFar;
+    return true;
+}
+
+// One eye's frustum, in Fast3D's conventions rather than Metal's.
+//
+// Two conventions have to be honoured and they are easy to conflate. Fast3D
+// expects clip z spanning [-w, w] and remaps it to [0, w] itself, on the CPU, in
+// GfxSpTri1 — so a Metal-convention projection handed straight over would be
+// remapped a second time and put every polygon in the front half of the depth
+// buffer. And the layout is row-vector: element [i][j] multiplies input
+// component i into output component j, which is the transpose of the usual
+// textbook form and, conveniently, exactly simd's column-major memory order.
+//
+// The tangents are not symmetric. A Vision Pro cants each eye's frustum outwards,
+// and a symmetric perspective built from an average would be wrong in a way that
+// looks almost right: the picture would be sharp, the depth plausible, and the
+// two eyes would disagree about where the horizon is.
+void BuildEyeFrustum(const float tangents[4], float nearPlane, float farPlane, float xScale,
+                     float frustum[4][4]) {
+    const float left = tangents[0];
+    const float right = tangents[1];
+    const float up = tangents[2];
+    const float down = tangents[3];
+
+    const float width = left + right;
+    const float height = up + down;
+
+    memset(frustum, 0, sizeof(float) * 16);
+    if (width < kMatrixEpsilon || height < kMatrixEpsilon) {
+        return;
+    }
+
+    // xScale carries the widescreen correction GfxSpVertex applies after this
+    // matrix has done its work. That correction exists to letterbox a 4:3 game
+    // onto a wider window, and there is no window here — the frustum already is
+    // the shape of the eye. Cancelling it in advance is cheaper and far less
+    // invasive than teaching the vertex path about a mode it otherwise ignores.
+    frustum[0][0] = (2.0f / width) * xScale;
+    frustum[2][0] = ((right - left) / width) * xScale;
+    frustum[1][1] = 2.0f / height;
+    frustum[2][1] = (up - down) / height;
+
+    const float depth = farPlane - nearPlane;
+    frustum[2][2] = -(farPlane + nearPlane) / depth;
+    frustum[3][2] = -2.0f * farPlane * nearPlane / depth;
+    frustum[2][3] = -1.0f;
+}
+
+} // namespace
+
+// Takes the eye's geometry for this frame and puts it in the terms the
+// interpreter works in: game units rather than metres, row vectors rather than
+// column ones.
+void Interpreter::BeginStereoEye(const SpaghettiPadEyeView& view, bool lastEye) {
+    mStereoLastEye = lastEye;
+    if (!view.valid) {
+        mStereoActive = false;
+        return;
+    }
+
+    // Coming from a frame that was not in stereo, the shadow copy starts as
+    // whatever the game last loaded. SpReset does not clear P_matrix, so a
+    // projection survives from frame to frame and a display list is entitled to
+    // multiply onto one it set earlier; seeding here is what keeps that true
+    // across the switch into Mode B. The factorisation is seeded conservatively
+    // — the survivor counts as the load, with nothing multiplied since — which
+    // only matters for draws before this display list's first projection load,
+    // and Mario Kart 64 loads one at the top of every frame.
+    if (!mStereoActive) {
+        memcpy(mStereoGameProjection, mRsp->P_matrix, sizeof(mStereoGameProjection));
+        memcpy(mStereoGameLoaded, mRsp->P_matrix, sizeof(mStereoGameLoaded));
+        mStereoGameHasPre = false;
+    }
+
+    // Per-eye, not per-entry: whether a perspective projection has been loaded
+    // yet is what separates a backdrop orthographic pass from an overlay one,
+    // and each eye walks the display list from its top.
+    mStereoEyeSawPerspective = false;
+
+    // No transpose: Fast3D's [i][j] and simd's column-major [column][row] are the
+    // same sixteen floats in the same order, because Fast3D multiplies its row
+    // vectors on the left. The one substantive conversion is below.
+    memcpy(mStereoEyeFromRecentre, view.eyeFromRecentre, sizeof(mStereoEyeFromRecentre));
+    memcpy(mStereoTangents, view.tangents, sizeof(mStereoTangents));
+
+    // The rotation is unitless and carries over as it is. The translation is a
+    // distance, and it arrives in metres while everything it will be added to is
+    // in game units.
+    const float metresPerUnit = SpaghettiPad_RenderWorldScale();
+    if (metresPerUnit > kMatrixEpsilon) {
+        mStereoEyeFromRecentre[3][0] /= metresPerUnit;
+        mStereoEyeFromRecentre[3][1] /= metresPerUnit;
+        mStereoEyeFromRecentre[3][2] /= metresPerUnit;
+    }
+
+    // Where the HUD goes: locked to the room rather than to the face. The panel
+    // is a fixed object in the recentre frame — a 4:3 rectangle
+    // kHudPanelWidthMetres across, kHudDistanceMetres ahead of where the wearer
+    // was when the world was placed, at their eye height — and each eye finds it
+    // by projecting the panel's centre through its own full pose, rotation
+    // included, every frame.
+    //
+    // The previous placement was head-anchored: the panel centred on each eye's
+    // frustum axis, converged by a shift computed from the eye translations
+    // alone. That approximation ignored the rotation in the eye transforms — a
+    // Vision Pro cants its eye views, and the interpreter's own frustum path
+    // honours that cant — so the HUD's per-eye disparity matched no single
+    // distance, and the wearer reported it pressed against their face. A real
+    // point through the real matrices makes the disparity exact by
+    // construction, and a panel that stays put in the room reads at its
+    // distance the way Mode A's screen already demonstrably does. It also means
+    // the HUD behaves like a cockpit instrument: look away and it leaves the
+    // view instead of following.
+    const float halfWidth = 0.5f * (mStereoTangents[0] + mStereoTangents[1]);
+    const float halfHeight = 0.5f * (mStereoTangents[2] + mStereoTangents[3]);
+    const auto placePanel = [&](float distanceMetres, float panelHalfWidthMetres,
+                                float centre[2], float scale[2]) {
+        centre[0] = 0.0f;
+        centre[1] = 0.0f;
+        scale[0] = 0.0f;
+        scale[1] = 0.0f;
+        if (!(metresPerUnit > kMatrixEpsilon) || !(halfWidth > kMatrixEpsilon) ||
+            !(halfHeight > kMatrixEpsilon)) {
+            return;
+        }
+        // The panel's centre in the recentre frame, in game units, through the
+        // eye transform. Row-vector layout — eye = point · M — and the point's
+        // x and y are zero, so only the z row and the translation row survive.
+        const float panelZ = -distanceMetres / metresPerUnit;
+        const float ex = panelZ * mStereoEyeFromRecentre[2][0] + mStereoEyeFromRecentre[3][0];
+        const float ey = panelZ * mStereoEyeFromRecentre[2][1] + mStereoEyeFromRecentre[3][1];
+        const float ez = panelZ * mStereoEyeFromRecentre[2][2] + mStereoEyeFromRecentre[3][2];
+        const float viewDepth = -ez;
+        // A panel behind the eye — the wearer has turned away from it — keeps
+        // the zero scale above, which collapses every 2D draw to a point that
+        // rasterizes nothing. A HUD behind the head should be nowhere, not
+        // mirrored back into view.
+        if (viewDepth > kMatrixEpsilon) {
+            // Inverting this eye's asymmetric frustum: an eye-space point lands
+            // at NDC (x/depth − (R−L)/2) / halfWidth, which is the same centre
+            // and offset BuildEyeFrustum encodes, read backwards.
+            centre[0] =
+                (ex / viewDepth - 0.5f * (mStereoTangents[1] - mStereoTangents[0])) / halfWidth;
+            centre[1] =
+                (ey / viewDepth - 0.5f * (mStereoTangents[2] - mStereoTangents[3])) / halfHeight;
+            const float panelHalfWidthUnits = panelHalfWidthMetres / metresPerUnit;
+            scale[0] = (panelHalfWidthUnits / viewDepth) / halfWidth;
+            // 4:3, matching the space the game draws its 2D in.
+            scale[1] = (panelHalfWidthUnits * 0.75f / viewDepth) / halfHeight;
+        }
