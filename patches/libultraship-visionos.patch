+    placePanel(kHudDistanceMetres, 0.5f * kHudPanelWidthMetres, mStereoHudCentre,
+               mStereoHudScale);
+    placePanel(kBackdropDistanceMetres,
+               kBackdropDistanceMetres * kBackdropHalfWidthTangent, mStereoBgCentre,
+               mStereoBgScale);
+
+    mStereoActive = true;
+}
