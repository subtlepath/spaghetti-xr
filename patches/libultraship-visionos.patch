diff --git a/include/fast/backends/gfx_visionos.h b/include/fast/backends/gfx_visionos.h
new file mode 100644
index 00000000..5366446f
--- /dev/null
+++ b/include/fast/backends/gfx_visionos.h
@@ -0,0 +1,207 @@
+//
+//  gfx_visionos.h
+//  libultraship
+//
+//  The window backend for visionOS, and the contract it renders through.
+//
+//  visionOS has no SDL window. SDL2's UIKit video driver is written against
+//  UIScreen, which is API_UNAVAILABLE(visionos), so the whole video subsystem is
+//  compiled out — and with it the CAMetalLayer that gfx_metal.cpp otherwise asks
+//  SDL for a drawable from. Compositor Services owns the display instead, so the
+//  engine renders each flat frame into a texture supplied by the application
+//  shell, which then shows that texture inside the immersive space.
+//
+//  This backend is therefore not "SDL2 minus the window". It is what the SDL2
+//  backend still owed the engine once the window was gone — dimensions, frame
+//  pacing, running state — with everything that only means something on a
+//  desktop answered honestly rather than faked.
+//
+#pragma once
+#ifdef __VISIONOS__
+
+#include "gfx_window_manager_api.h"
+
+#include <chrono>
+#include <cstdint>
+#include <string>
+
+// How many eyes a stereo frame has. Two everywhere this runs; named because the
+// ring, the loop over eyes and the surface's slots all have to agree, and a bare
+// 2 in three files is three chances to disagree.
+#define SPAGHETTIPAD_EYE_COUNT 2
+
+// ------------------------------------------------------------- shell contract
+//
+// Defined by the application shell (visionos/SpaghettiPadRenderSurface.mm) and
+// called from the engine thread. Declared here rather than included from the
+// shell so libultraship keeps no dependency on the application's headers, and
+// deliberately not weak: a missing definition is a link error, not a renderer
+// that quietly draws into nothing.
+extern "C" {
+
+// The single Metal device the engine and the compositor share. Both sample and
+// render the same textures, so a second device would not merely be wasteful, it
+// would be wrong.
+void* SpaghettiPad_RenderMetalDevice(void);
+
+// The engine's render surface in pixels. In Mode A this is a fixed flat frame;
+// in Mode B it is one eye's viewport, which the compositor reports and which is
+// therefore not known until the immersive space has handed over its first
+// drawable. Either way the engine asks every frame, so a change is picked up.
+void SpaghettiPad_RenderSurfaceSize(uint32_t* width, uint32_t* height);
+
+// Takes the next texture of the surface's ring, waiting if the GPU still holds
+// every one of them. This is the Compositor Services analogue of
+// -[CAMetalLayer nextDrawable], and it is called from the same place. In Mode B
+// it returns the texture for the eye most recently selected by
+// SpaghettiPad_RenderBeginEye.
+void* SpaghettiPad_RenderAcquireTexture(void);
+
+// Hands that texture to the compositor once `commandBuffer` — the committed
+// command buffer that rendered it — completes. The analogue of
+// -[MTLCommandBuffer presentDrawable:], and it is called from the same place.
+void SpaghettiPad_RenderPublishTexture(void* texture, void* commandBuffer);
+
+// Non-zero while the immersive space is open and consuming frames. When it is
+// zero the game loop idles rather than rendering frames nothing will show.
+int SpaghettiPad_RenderIsLive(void);
+
+// ------------------------------------------------------------------ Mode B
+//
+// Mode A draws the game flat and hangs it on a screen in the room; everything
+// stereoscopic about it belongs to the screen, not to the game. Mode B draws the
+// game itself in stereo: the display list runs once per eye, with the wearer's
+// head standing in for the game's camera, so the world has depth rather than
+// being a picture of a world that has depth.
+//
+// What that costs is one full interpreter pass per eye. What it needs from the
+// shell is, per eye and per frame, the two things the compositor knows and the
+// engine cannot: the shape of that eye's frustum, and where that eye is.
+
+// One eye's geometry for one frame, as the compositor reports it.
+//
+// Guarded rather than simply declared, because the shell's own contract header
+// carries the identical definition. Neither tree may include the other's
+// headers — that boundary is the whole point of this file — so the type is
+// written out twice and whichever translation unit sees it first defines it.
+#ifndef SPAGHETTIPAD_EYE_VIEW_DEFINED
+#define SPAGHETTIPAD_EYE_VIEW_DEFINED
+typedef struct SpaghettiPadEyeView {
+    // Tangents of the angles bounding this eye's frustum, measured from the view
+    // axis: left, right, up, down. All four are positive magnitudes, and they are
+    // not symmetric — a Vision Pro's frustums are canted outwards, which is
+    // exactly the asymmetry a hand-rolled symmetric perspective would discard.
+    float tangents[4];
+
+    // Where this eye sits relative to the pose the world was last recentred to,
+    // already inverted: eye-from-recentre, in metres.
+    //
+    // Column-major, which is both simd's own memory order and — because Fast3D
+    // multiplies row vectors on the left — precisely the layout its float[4][4]
+    // matrices use. The engine copies it without transposing and rescales the
+    // translation into game units; see kMetresPerGameUnit.
+    float eyeFromRecentre[16];
+
+    // Non-zero once these came from a real drawable. Before the immersive space
+    // has handed one over there is nothing truthful to report, and the engine
+    // renders Mode A's flat frame rather than guessing at a frustum.
+    int valid;
+} SpaghettiPadEyeView;
+#endif
+
+// Non-zero when the engine should render this frame in stereo. Read once per
+// frame: the mode can be switched while the game is running, and a frame must
+// not change its mind halfway through.
+int SpaghettiPad_RenderStereoEnabled(void);
+
+// Opens a stereo frame and reserves one ring slot for both of its eyes. Returns
+// zero if no slot is free, in which case the engine skips the frame rather than
+// rendering half of one.
+int SpaghettiPad_RenderBeginStereoFrame(void);
+
+// Selects which eye the next SpaghettiPad_RenderAcquireTexture belongs to, and
+// fills in that eye's geometry for this frame. Returns zero if the compositor
+// has nothing to report, which the engine treats as "not in stereo this frame".
+int SpaghettiPad_RenderBeginEye(int eye, SpaghettiPadEyeView* view);
+
+// Metres per game unit: how big Mario Kart 64's world is when a real person
+// stands in it. Nothing in the ROM says, so this is a comfort setting rather
+// than a measurement, and it lives in the shell so it can be changed without
+// rebuilding the engine.
+float SpaghettiPad_RenderWorldScale(void);
+
+// The rate the compositor is presenting at, measured rather than assumed: the
+// Simulator runs at 60 Hz and a headset at 90 or more. This is the engine's only
+// way to ask what the display is doing, since it no longer has one.
+uint32_t SpaghettiPad_RenderDisplayRate(void);
+
+// Called when the set of game controllers the control deck has actually opened
+// changes: `count` is how many it holds and `names` is their comma-separated SDL
+// names, or an empty string when there are none.
+//
+// This reports the engine's own state rather than SDL's raw device list, because
+// the two differ for reasons worth telling apart — a pad SDL enumerates but has
+// no mapping for is never opened, and reads as no controller at all. Nothing on
+// a headset can be seen or captured, so a log line is the only way to tell a
+// controller that never paired from one that paired and was never read.
+void SpaghettiPad_InputDevicesChanged(int count, const char* names);
+}
+
+namespace Fast {
+
+class GfxWindowBackendVisionOS final : public GfxWindowBackend {
+  public:
+    GfxWindowBackendVisionOS() = default;
+    ~GfxWindowBackendVisionOS() override = default;
+
+    void Init(const char* gameName, const char* apiName, bool startFullScreen, uint32_t width, uint32_t height,
+              int32_t posX, int32_t posY) override;
+    void Close() override;
+    void SetKeyboardCallbacks(bool (*onKeyDown)(int scancode), bool (*onKeyUp)(int scancode),
+                              void (*onAllKeysUp)()) override;
+    void SetMouseCallbacks(bool (*onMouseButtonDown)(int btn), bool (*onMouseButtonUp)(int btn)) override;
+    void SetFullscreenChangedCallback(void (*onFullscreenChanged)(bool isNowFullscreen)) override;
+    void SetFullscreen(bool fullscreen) override;
+    void GetActiveWindowRefreshRate(uint32_t* refreshRate) override;
+    void SetCursorVisibility(bool visible) override;
+    void SetMousePos(int32_t posX, int32_t posY) override;
+    void GetMousePos(int32_t* x, int32_t* y) override;
+    void GetMouseDelta(int32_t* x, int32_t* y) override;
+    void GetMouseWheel(float* x, float* y) override;
+    bool GetMouseState(uint32_t btn) override;
+    void SetMouseCapture(bool capture) override;
+    bool IsMouseCaptured() override;
+    void GetDimensions(uint32_t* width, uint32_t* height, int32_t* posX, int32_t* posY) override;
+    void HandleEvents() override;
+    bool IsFrameReady() override;
+    void SwapBuffersBegin() override;
+    void SwapBuffersEnd() override;
+    double GetTime() override;
+    int GetTargetFps() override;
+    void SetTargetFps(int fps) override;
+    void SetMaxFrameLatency(int latency) override;
+    const char* GetKeyName(int scancode) override;
+    bool CanDisableVsync() override;
+    bool IsRunning() override;
+    void Destroy() override;
+    bool IsFullscreen() override;
+
+  private:
+    void SyncFramerateWithTime();
+    void ReportInputDevices();
+
+    std::chrono::steady_clock::time_point mNextFrame{};
+    void (*mOnAllKeysUp)() = nullptr;
+
+    // The last set reported through SpaghettiPad_InputDevicesChanged, so the
+    // report is an edge rather than a line every frame. The first report is made
+    // whatever it finds, including nothing: a log with no line about controllers
+    // at all would not distinguish "none connected" from a reporting path that
+    // never ran, and on a headset the log is the only witness there is.
+    std::string mReportedInputDevices;
+    bool mHasReportedInputDevices = false;
+};
+
+} // namespace Fast
+
+#endif
