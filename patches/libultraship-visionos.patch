+        mInterpreter->EndStereoEye();
+        gui->EndDraw();
+
+        // Only the last eye paces. Both submit, both present into the ring, but
+        // a frame is one interval of wall-clock however many times it was drawn.
+        mInterpreter->EndFrame(eye == SPAGHETTIPAD_EYE_COUNT - 1);
