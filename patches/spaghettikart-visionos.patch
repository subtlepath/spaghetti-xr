+  # This also forces SDL_VIRTUAL_JOYSTICK off, since SDL declares it dependent on
+  # SDL_HIDAPI. Nothing needs it yet. Phase 5 has to feed PS VR2 Sense poses,
+  # which arrive from ARKit rather than from any joystick SDL can see, so how
+  # they reach the control deck is that phase's decision either way.
+  set(SDL_HIDAPI OFF CACHE BOOL "" FORCE)
+  # SDL's CoreMotion sensor driver is compiled for visionOS but is written
+  # against CMMotionManager, which visionOS does not provide. Head and
+  # accessory pose come from ARKit here, so nothing wants SDL sensors.
+  set(SDL_SENSOR OFF CACHE BOOL "" FORCE)
+  # SDL's misc subsystem is only SDL_OpenURL, and its iOS backend calls
+  # -[UIApplication openURL:], which is API_UNAVAILABLE(visionos). Turning the
+  # subsystem off selects SDL's own dummy backend, so SDL_OpenURL still links
+  # and returns SDL_Unsupported() instead of vanishing. The single caller is
+  # upstream's desktop "Open App Files Folder" button, which has nothing to
+  # open on visionOS.
+  set(SDL_MISC OFF CACHE BOOL "" FORCE)
