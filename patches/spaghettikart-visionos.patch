+// The texture-pack switch, reachable from outside the engine.
+//
+// Upstream's only way to turn alternate assets on is the Enhancements menu, and
+// an immersive space has no menu to reach with a mouse. The loop above already
+// notices the CVar changing and reloads every texture through the resource
+// manager, so this is deliberately nothing more than a setter: the machinery
+// exists, it just had no way in.
+//
+// Saved immediately because an imported pack is a decision the wearer made once
+// and should not have to make again.
+// Both are reachable from SwiftUI, which exists before the engine does. Every
+// path through them touches the console variable system, which is part of the
+// engine's context — so a null context is "not yet", not a crash.
+extern "C" void SpaghettiPad_SetAlternateAssets(int enabled) {
+    auto context = Ship::Context::GetInstance();
+    if (context == nullptr || context->GetConsoleVariables() == nullptr) {
+        return;
+    }
+    CVarSetInteger("gEnhancements.Mods.AlternateAssets", enabled != 0 ? 1 : 0);
+    context->GetConsoleVariables()->Save();
+}
+
+extern "C" int SpaghettiPad_AlternateAssetsEnabled(void) {
+    auto context = Ship::Context::GetInstance();
+    if (context == nullptr || context->GetConsoleVariables() == nullptr) {
+        return 0;
+    }
+    return CVarGetInteger("gEnhancements.Mods.AlternateAssets", 0);
+}
+#endif
