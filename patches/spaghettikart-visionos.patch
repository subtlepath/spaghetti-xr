+// ------------------------------------------------------------------- engine
+
+// Called from push_frame, on the engine thread, once per game frame. Everything
+// that touches the tree, the CVars or a widget's callback happens here.
+extern "C" void SpaghettiPad_MenuPump(void) {
+    DrainEdits();
+
+    const std::shared_ptr<GameUI::PortMenu>& menu = GameUI::mPortMenu;
+
+    // Ahead of the polling check: a window that has just been closed turns
+    // polling off in the same breath, and this is the request that has to land
+    // anyway or the game stays paused behind a window that is gone.
+    const int wantedVisibility = gPendingVisibility.exchange(-1, std::memory_order_acq_rel);
+    if (wantedVisibility >= 0 && menu != nullptr) {
+        wantedVisibility != 0 ? menu->Show() : menu->Hide();
+    }
+
+    if (!gPolling.load(std::memory_order_acquire)) {
+        return;
+    }
+
+    if (menu == nullptr) {
+        return;
+    }
+
+    bool structureChanged = false;
+    if (gFlat.empty() || ShapeChanged()) {
+        Rebuild();
+        gGeneration.fetch_add(1, std::memory_order_acq_rel);
+        structureChanged = true;
+    }
+
+    // The two things Menu::DrawElement does before it draws anything, and the
+    // reason a widget knows whether it is hidden. Neither touches ImGui, which
+    // is what makes running them outside a draw frame legitimate rather than
+    // merely convenient.
+    for (auto& [reason, info] : menu->GetDisabledMap()) {
+        info.active = info.evaluation(info);
+    }
+    for (FlatWidget& flat : gFlat) {
+        flat.info->activeDisables.clear();
+        if (flat.info->preFunc != nullptr) {
+            flat.info->preFunc(*flat.info);
+        }
+    }
+
+    std::string structure;
+    if (structureChanged) {
+        structure = BuildStructure();
+    }
+    std::string values = BuildValues();
+
+    {
+        std::lock_guard<std::mutex> lock(gPublishMutex);
+        if (structureChanged) {
+            gPublishedStructure = std::move(structure);
+        }
+        gPublishedValues = std::move(values);
+    }
+}
+
+// -------------------------------------------------------------------- shell
+
+extern "C" void SpaghettiPad_MenuSetPolling(int wanted) {
+    gPolling.store(wanted != 0, std::memory_order_release);
+}
+
+extern "C" uint32_t SpaghettiPad_MenuGeneration(void) {
+    return gGeneration.load(std::memory_order_acquire);
+}
+
+extern "C" int SpaghettiPad_MenuStructureJSON(char* out, int capacity) {
+    std::lock_guard<std::mutex> lock(gPublishMutex);
+    return CopyOut(gPublishedStructure, out, capacity);
+}
+
+extern "C" int SpaghettiPad_MenuValuesJSON(char* out, int capacity) {
+    std::lock_guard<std::mutex> lock(gPublishMutex);
+    return CopyOut(gPublishedValues, out, capacity);
+}
+
+extern "C" void SpaghettiPad_MenuSetInt(int id, int value) {
+    PendingEdit edit;
+    edit.kind = PendingEdit::Kind::Int;
+    edit.id = id;
+    edit.intValue = value;
+    QueueEdit(edit);
+}
+
+extern "C" void SpaghettiPad_MenuSetFloat(int id, float value) {
+    PendingEdit edit;
+    edit.kind = PendingEdit::Kind::Float;
+    edit.id = id;
+    edit.floatValue = value;
+    QueueEdit(edit);
+}
+
+extern "C" void SpaghettiPad_MenuSetColor(int id, uint32_t rgba) {
+    PendingEdit edit;
+    edit.kind = PendingEdit::Kind::Color;
+    edit.id = id;
+    edit.colorValue = rgba;
+    QueueEdit(edit);
+}
+
+extern "C" void SpaghettiPad_MenuActivate(int id) {
+    PendingEdit edit;
+    edit.kind = PendingEdit::Kind::Activate;
+    edit.id = id;
+    QueueEdit(edit);
+}
+
+// The wearer closed the native window, so the menu is no longer visible — which
+// the engine has to be told, or it goes on blocking game input for a menu that
+// is not on screen. Queued like everything else: menu visibility is ImGui state
+// and belongs to the engine thread.
+extern "C" void SpaghettiPad_MenuRequestVisible(int visible) {
+    gPendingVisibility.store(visible != 0 ? 1 : 0, std::memory_order_release);
+}
