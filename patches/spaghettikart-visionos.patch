diff --git a/src/port/ui/SpaghettiPadMenuBridge.cpp b/src/port/ui/SpaghettiPadMenuBridge.cpp
new file mode 100644
index 000000000..4a6038adf
--- /dev/null
+++ b/src/port/ui/SpaghettiPadMenuBridge.cpp
@@ -0,0 +1,636 @@
+// The settings menu, as data, for a native SwiftUI window to draw.
+//
+// visionOS is the one platform where the ImGui menu is genuinely the wrong
+// answer. Everywhere else it is drawn into a window a person is already looking
+// at with a mouse; here it is drawn into the game's own framebuffer, which is a
+// texture floating in a room, at a size and a font chosen for a monitor. The
+// wearer reads it at two metres.
+//
+// What this file does *not* do is re-describe the menu. Upstream already
+// declares it — `PortMenu::AddSettings()` and friends build a tree of
+// `WidgetInfo`, each with a label, a CVar, a type, an options struct and a
+// tooltip — and hand-copying 119 of those into Swift would produce a second
+// source of truth that goes stale the first time upstream adds a checkbox. So
+// the tree is walked and published as JSON, and the Swift side is a renderer for
+// whatever it finds rather than a transcription of what was there today.
+//
+// Threading, which is the whole of the difficulty. The tree, the CVars and the
+// widgets' own callbacks are engine-thread state; SwiftUI is the main actor.
+// Nothing here is called across that line directly:
+//
+//   - the engine builds a snapshot at the top of a frame and publishes it under
+//     a mutex; the shell copies the last published one and never blocks on a
+//     frame;
+//   - the shell queues changes; the engine drains that queue at the top of the
+//     next frame and runs each widget's callback there, which is the same thread
+//     the ImGui menu would have run it on.
+//
+// The precedent for both is ApplyPendingReset in Game.cpp: request on any
+// thread, apply at the top of the next game frame.
+
+#ifdef __VISIONOS__
+
+#include "PortMenu.h"
+#include "MenuTypes.h"
+#include "UIWidgets.h"
+
+#include <libultraship/libultraship.h>
+
+#include <nlohmann/json.hpp>
+
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <variant>
+#include <vector>
+
+namespace GameUI {
+extern std::shared_ptr<PortMenu> mPortMenu;
+}
+
+namespace {
+
+// A widget, found. `info` points into the menu's own tree, which outlives every
+// snapshot: the tree is built once in PortMenu::InitElement and only the search
+// sidebar is ever inserted or removed after that.
+struct FlatWidget {
+    std::string section;
+    std::string page;
+    WidgetInfo* info = nullptr;
+};
+
+std::vector<FlatWidget> gFlat;
+
+// Bumped whenever the shape changes, so the shell knows to re-read the
+// structure rather than only the values. The search sidebar going in and out is
+// the one thing that moves it in practice.
+std::atomic<uint32_t> gGeneration{0};
+
+// What the shell reads. Both are whole JSON documents, replaced wholesale.
+std::mutex gPublishMutex;
+std::string gPublishedStructure;
+std::string gPublishedValues;
+
+// What the shell has asked for. Snapshotting costs a tree walk and a JSON
+// encode per frame, so it only happens while a window is actually open.
+std::atomic<bool> gPolling{false};
+
+// A change the shell made, waiting for a thread that may run callbacks.
+struct PendingEdit {
+    enum class Kind { Int, Float, Color, Activate } kind = Kind::Int;
+    int id = 0;
+    int32_t intValue = 0;
+    float floatValue = 0.0f;
+    uint32_t colorValue = 0;
+};
+
+std::mutex gEditMutex;
+std::vector<PendingEdit> gPendingEdits;
+
+// -1 for "nothing asked", otherwise the visibility the shell wants. A single
+// atomic rather than a queue entry because only the latest answer matters: a
+// window opened and closed twice before the engine ran a frame should end up
+// closed, not toggled twice.
+std::atomic<int> gPendingVisibility{ -1 };
+
+const char* TypeName(WidgetType type) {
+    switch (type) {
+        case WIDGET_CHECKBOX:
+        case WIDGET_CVAR_CHECKBOX:
+            return "checkbox";
+        case WIDGET_COMBOBOX:
+        case WIDGET_CVAR_COMBOBOX:
+            return "combobox";
+        case WIDGET_SLIDER_INT:
+        case WIDGET_CVAR_SLIDER_INT:
+            return "sliderInt";
+        case WIDGET_SLIDER_FLOAT:
+        case WIDGET_CVAR_SLIDER_FLOAT:
+            return "sliderFloat";
+        case WIDGET_BUTTON:
+            return "button";
+        case WIDGET_COLOR_24:
+            return "color24";
+        case WIDGET_COLOR_32:
+            return "color32";
+        case WIDGET_SEARCH:
+            return "search";
+        case WIDGET_SEPARATOR:
+            return "separator";
+        case WIDGET_SEPARATOR_TEXT:
+            return "separatorText";
+        case WIDGET_TEXT:
+            return "text";
+        case WIDGET_WINDOW_BUTTON:
+            return "windowButton";
+        case WIDGET_AUDIO_BACKEND:
+            return "audioBackend";
+        case WIDGET_VIDEO_BACKEND:
+            return "videoBackend";
+        case WIDGET_CUSTOM:
+            return "custom";
+    }
+    return "unknown";
+}
+
+// Whether a widget's value lives in a CVar, as opposed to a raw pointer the
+// menu owns. The pointer kinds exist for things like the fullscreen toggle,
+// which reflects window state rather than a setting, and they are read and
+// written through `valuePointer` instead.
+bool IsCVarBacked(WidgetType type) {
+    switch (type) {
+        case WIDGET_CVAR_CHECKBOX:
+        case WIDGET_CVAR_COMBOBOX:
+        case WIDGET_CVAR_SLIDER_INT:
+        case WIDGET_CVAR_SLIDER_FLOAT:
+        case WIDGET_COLOR_24:
+        case WIDGET_COLOR_32:
+            return true;
+        default:
+            return false;
+    }
+}
+
+// Walks the menu in the order a person reads it: header order, then that
+// header's own sidebar order, then column by column. The index into this vector
+// is the id the shell uses for everything afterwards, so the walk has to be
+// deterministic — which is why it follows `menuOrder` and `sidebarOrder` rather
+// than iterating the unordered_maps they index.
+void Rebuild() {
+    gFlat.clear();
+
+    const std::shared_ptr<GameUI::PortMenu>& menu = GameUI::mPortMenu;
+    if (menu == nullptr) {
+        return;
+    }
+
+    for (const std::string& sectionName : menu->GetMenuOrder()) {
+        auto sectionIt = menu->GetMenuEntries().find(sectionName);
+        if (sectionIt == menu->GetMenuEntries().end()) {
+            continue;
+        }
+        MainMenuEntry& section = const_cast<MainMenuEntry&>(sectionIt->second);
+
+        for (const std::string& pageName : section.sidebarOrder) {
+            auto pageIt = section.sidebars.find(pageName);
+            if (pageIt == section.sidebars.end()) {
+                continue;
+            }
+            SidebarEntry& page = const_cast<SidebarEntry&>(pageIt->second);
+
+            for (std::vector<WidgetInfo>& column : page.columnWidgets) {
+                for (WidgetInfo& widget : column) {
+                    gFlat.push_back({ sectionName, pageName, &widget });
+                }
+            }
+        }
+    }
+}
+
+// True when the tree is no longer the shape the flat list was built from. Cheap
+// enough to run every frame and cheaper than rebuilding blind.
+bool ShapeChanged() {
+    const std::shared_ptr<GameUI::PortMenu>& menu = GameUI::mPortMenu;
+    if (menu == nullptr) {
+        return !gFlat.empty();
+    }
+
+    size_t count = 0;
+    for (const std::string& sectionName : menu->GetMenuOrder()) {
+        auto sectionIt = menu->GetMenuEntries().find(sectionName);
+        if (sectionIt == menu->GetMenuEntries().end()) {
+            continue;
+        }
+        for (const std::string& pageName : sectionIt->second.sidebarOrder) {
+            auto pageIt = sectionIt->second.sidebars.find(pageName);
+            if (pageIt == sectionIt->second.sidebars.end()) {
+                continue;
+            }
+            for (const std::vector<WidgetInfo>& column : pageIt->second.columnWidgets) {
+                count += column.size();
+            }
+        }
+    }
+    return count != gFlat.size();
+}
+
+void EncodeOptions(nlohmann::json& out, const FlatWidget& flat) {
+    const WidgetInfo& widget = *flat.info;
+    if (widget.options == nullptr) {
+        return;
+    }
+
+    out["tooltip"] = widget.options->tooltip != nullptr ? widget.options->tooltip : "";
+
+    switch (widget.type) {
+        case WIDGET_CHECKBOX:
+        case WIDGET_CVAR_CHECKBOX: {
+            const auto* options = static_cast<const UIWidgets::CheckboxOptions*>(widget.options.get());
+            out["default"] = options->defaultValue ? 1 : 0;
+            break;
+        }
+        case WIDGET_COMBOBOX:
+        case WIDGET_CVAR_COMBOBOX:
+        case WIDGET_AUDIO_BACKEND:
+        case WIDGET_VIDEO_BACKEND: {
+            const auto* options = static_cast<const UIWidgets::ComboboxOptions*>(widget.options.get());
+            out["default"] = static_cast<int32_t>(options->defaultIndex);
+            // Sorted by value: comboMap is unordered, and a picker whose entries
+            // shuffle between snapshots is unusable.
+            std::vector<std::pair<int32_t, const char*>> entries(options->comboMap.begin(),
+                                                                options->comboMap.end());
+            std::sort(entries.begin(), entries.end(),
+                      [](const auto& a, const auto& b) { return a.first < b.first; });
+            for (const auto& [value, label] : entries) {
+                out["entries"].push_back({ { "value", value }, { "label", label != nullptr ? label : "" } });
+            }
+            break;
+        }
+        case WIDGET_SLIDER_INT:
+        case WIDGET_CVAR_SLIDER_INT: {
+            const auto* options = static_cast<const UIWidgets::IntSliderOptions*>(widget.options.get());
+            out["min"] = options->min;
+            out["max"] = options->max;
+            out["step"] = options->step;
+            out["default"] = options->defaultValue;
+            out["format"] = options->format != nullptr ? options->format : "%d";
+            break;
+        }
+        case WIDGET_SLIDER_FLOAT:
+        case WIDGET_CVAR_SLIDER_FLOAT: {
+            const auto* options = static_cast<const UIWidgets::FloatSliderOptions*>(widget.options.get());
+            out["min"] = options->min;
+            out["max"] = options->max;
+            out["step"] = options->step;
+            out["default"] = options->defaultValue;
+            out["format"] = options->format != nullptr ? options->format : "%f";
+            out["isPercentage"] = options->isPercentage;
+            break;
+        }
+        default:
+            break;
+    }
+}
+
+std::string BuildStructure() {
+    nlohmann::json root;
+    root["generation"] = gGeneration.load(std::memory_order_acquire);
+
+    // Rebuilt as a nested document even though the walk is flat, because the
+    // shell draws sections and pages and should not have to re-derive them by
+    // grouping on a string.
+    nlohmann::json sections = nlohmann::json::array();
+    std::string currentSection;
+    std::string currentPage;
+
+    for (size_t i = 0; i < gFlat.size(); i++) {
+        const FlatWidget& flat = gFlat[i];
+
+        if (sections.empty() || currentSection != flat.section) {
+            sections.push_back({ { "name", flat.section }, { "pages", nlohmann::json::array() } });
+            currentSection = flat.section;
+            currentPage.clear();
+        }
+        nlohmann::json& section = sections.back();
+
+        if (section["pages"].empty() || currentPage != flat.page) {
+            section["pages"].push_back({ { "name", flat.page }, { "widgets", nlohmann::json::array() } });
+            currentPage = flat.page;
+        }
+
+        nlohmann::json widget;
+        widget["id"] = static_cast<int>(i);
+        widget["type"] = TypeName(flat.info->type);
+        widget["label"] = flat.info->name;
+        widget["cvar"] = flat.info->cVar != nullptr ? flat.info->cVar : "";
+        widget["window"] = flat.info->windowName != nullptr ? flat.info->windowName : "";
+        EncodeOptions(widget, flat);
+
+        section["pages"].back()["widgets"].push_back(std::move(widget));
+    }
+
+    root["sections"] = std::move(sections);
+    return root.dump();
+}
+
+// The current value of one widget, in whatever kind it is stored.
+double ReadValue(const FlatWidget& flat) {
+    const WidgetInfo& widget = *flat.info;
+
+    // Whether the ImGui window this button opens is open right now, so the
+    // native control can show it as on rather than as a button that does
+    // something invisible.
+    if (widget.type == WIDGET_WINDOW_BUTTON) {
+        if (widget.windowName == nullptr || widget.windowName[0] == '\0') {
+            return 0.0;
+        }
+        auto window = Ship::Context::GetInstance()->GetWindow()->GetGui()->GetGuiWindow(widget.windowName);
+        return window != nullptr && window->IsVisible() ? 1.0 : 0.0;
+    }
+
+    if (IsCVarBacked(widget.type)) {
+        if (widget.cVar == nullptr) {
+            return 0.0;
+        }
+        switch (widget.type) {
+            case WIDGET_CVAR_SLIDER_FLOAT:
+                return CVarGetFloat(widget.cVar, 0.0f);
+            case WIDGET_COLOR_24: {
+                const Color_RGB8 color = CVarGetColor24(widget.cVar, Color_RGB8{ 0, 0, 0 });
+                return static_cast<double>((static_cast<uint32_t>(color.r) << 16) |
+                                           (static_cast<uint32_t>(color.g) << 8) |
+                                           static_cast<uint32_t>(color.b));
+            }
+            case WIDGET_COLOR_32: {
+                const Color_RGBA8 color = CVarGetColor(widget.cVar, Color_RGBA8{ 0, 0, 0, 255 });
+                return static_cast<double>((static_cast<uint32_t>(color.r) << 24) |
+                                           (static_cast<uint32_t>(color.g) << 16) |
+                                           (static_cast<uint32_t>(color.b) << 8) |
+                                           static_cast<uint32_t>(color.a));
+            }
+            default:
+                return CVarGetInteger(widget.cVar, 0);
+        }
+    }
+
+    // Pointer-backed widgets reflect live state — window fullscreen, a backend
+    // selection — which preFunc has just refreshed.
+    if (std::holds_alternative<bool*>(widget.valuePointer)) {
+        bool* value = std::get<bool*>(widget.valuePointer);
+        return value != nullptr && *value ? 1.0 : 0.0;
+    }
+    if (std::holds_alternative<int32_t*>(widget.valuePointer)) {
+        int32_t* value = std::get<int32_t*>(widget.valuePointer);
+        return value != nullptr ? *value : 0.0;
+    }
+    if (std::holds_alternative<float*>(widget.valuePointer)) {
+        float* value = std::get<float*>(widget.valuePointer);
+        return value != nullptr ? *value : 0.0;
+    }
+    return 0.0;
+}
+
+std::string BuildValues() {
+    nlohmann::json root;
+    root["generation"] = gGeneration.load(std::memory_order_acquire);
+
+    // Compact triples rather than named objects: this document is rebuilt every
+    // frame the window is open, and 119 objects of three keys each is a lot of
+    // punctuation to encode and parse sixty times a second.
+    nlohmann::json values = nlohmann::json::array();
+    for (size_t i = 0; i < gFlat.size(); i++) {
+        const WidgetInfo& widget = *gFlat[i].info;
+        uint32_t flags = 0;
+        if (widget.isHidden) {
+            flags |= 1u;
+        }
+        if (widget.options != nullptr && widget.options->disabled) {
+            flags |= 2u;
+        }
+        if (!widget.activeDisables.empty()) {
+            flags |= 2u;
+        }
+        values.push_back({ static_cast<int>(i), ReadValue(gFlat[i]), flags });
+    }
+
+    root["values"] = std::move(values);
+    return root.dump();
+}
+
+void ApplyEdit(const PendingEdit& edit) {
+    if (edit.id < 0 || static_cast<size_t>(edit.id) >= gFlat.size()) {
+        return;
+    }
+    WidgetInfo& widget = *gFlat[edit.id].info;
+
+    switch (edit.kind) {
+        case PendingEdit::Kind::Int:
+            if (IsCVarBacked(widget.type) && widget.cVar != nullptr) {
+                CVarSetInteger(widget.cVar, edit.intValue);
+            } else if (std::holds_alternative<bool*>(widget.valuePointer)) {
+                bool* value = std::get<bool*>(widget.valuePointer);
+                if (value != nullptr) {
+                    *value = edit.intValue != 0;
+                }
+            } else if (std::holds_alternative<int32_t*>(widget.valuePointer)) {
+                int32_t* value = std::get<int32_t*>(widget.valuePointer);
+                if (value != nullptr) {
+                    *value = edit.intValue;
+                }
+            }
+            break;
+        case PendingEdit::Kind::Float:
+            if (IsCVarBacked(widget.type) && widget.cVar != nullptr) {
+                CVarSetFloat(widget.cVar, edit.floatValue);
+            } else if (std::holds_alternative<float*>(widget.valuePointer)) {
+                float* value = std::get<float*>(widget.valuePointer);
+                if (value != nullptr) {
+                    *value = edit.floatValue;
+                }
+            }
+            break;
+        case PendingEdit::Kind::Color:
+            if (widget.cVar == nullptr) {
+                break;
+            }
+            if (widget.type == WIDGET_COLOR_24) {
+                CVarSetColor24(widget.cVar,
+                               Color_RGB8{ static_cast<uint8_t>((edit.colorValue >> 16) & 0xFF),
+                                           static_cast<uint8_t>((edit.colorValue >> 8) & 0xFF),
+                                           static_cast<uint8_t>(edit.colorValue & 0xFF) });
+            } else {
+                CVarSetColor(widget.cVar,
+                             Color_RGBA8{ static_cast<uint8_t>((edit.colorValue >> 24) & 0xFF),
+                                          static_cast<uint8_t>((edit.colorValue >> 16) & 0xFF),
+                                          static_cast<uint8_t>((edit.colorValue >> 8) & 0xFF),
+                                          static_cast<uint8_t>(edit.colorValue & 0xFF) });
+            }
+            break;
+        case PendingEdit::Kind::Activate:
+            // A window button is a toggle wearing a button's clothes: upstream's
+            // UIWidgets::WindowButton flips a GuiWindow's visibility and stores
+            // it in the widget's CVar. The ImGui debug windows behind these —
+            // the Gfx debugger, the console, the stats overlay — have no native
+            // equivalent and are not going to get one, so the native menu opens
+            // them exactly as the ImGui menu did.
+            if (widget.type == WIDGET_WINDOW_BUTTON && widget.windowName != nullptr &&
+                widget.windowName[0] != '\0') {
+                auto window = Ship::Context::GetInstance()->GetWindow()->GetGui()->GetGuiWindow(widget.windowName);
+                if (window != nullptr) {
+                    window->IsVisible() ? window->Hide() : window->Show();
+                }
+            }
+            break;
+    }
+
+    // The widget's own callback, on the thread that would have run it if a
+    // person had clicked the ImGui version. This is where "Reset to defaults"
+    // resets, where the fullscreen toggle toggles, and where 6DoF steering
+    // reaches the shell — skipping it would set the CVar and change nothing.
+    if (widget.callback != nullptr) {
+        widget.callback(widget);
+    }
+
+    // Upstream saves on change; a wearer who closes the app without ever
+    // opening the ImGui menu should not lose what they set.
+    Ship::Context::GetInstance()->GetConsoleVariables()->Save();
+}
+
+void DrainEdits() {
+    std::vector<PendingEdit> edits;
+    {
+        std::lock_guard<std::mutex> lock(gEditMutex);
+        edits.swap(gPendingEdits);
+    }
+    for (const PendingEdit& edit : edits) {
+        ApplyEdit(edit);
+    }
+}
+
+void QueueEdit(const PendingEdit& edit) {
+    std::lock_guard<std::mutex> lock(gEditMutex);
+    // Bounded so a shell that queues faster than the engine drains — a slider
+    // being dragged while the game is paused on a loading screen — cannot grow
+    // this without limit. The newest edit is the one that matters.
+    constexpr size_t kMaxPending = 256;
+    if (gPendingEdits.size() >= kMaxPending) {
+        gPendingEdits.erase(gPendingEdits.begin());
+    }
+    gPendingEdits.push_back(edit);
+}
+
+int CopyOut(const std::string& source, char* out, int capacity) {
+    const int needed = static_cast<int>(source.size());
+    if (out != nullptr && capacity > 0) {
+        const int copied = needed < capacity - 1 ? needed : capacity - 1;
+        std::memcpy(out, source.data(), static_cast<size_t>(copied));
+        out[copied] = '\0';
+    }
+    return needed;
+}
+
+} // namespace
